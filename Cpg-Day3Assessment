package Assignment;

import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;

public class Assignment6 {

	public static void main(String[] args) throws InterruptedException {
		ChromeOptions option = new ChromeOptions();
		//option.addArguments("--disable-notification");
		option.addArguments("--incognito");
		WebDriver driver = new ChromeDriver(option);
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://www.easemytrip.com/");
		Thread.sleep(3000);
		//selecting from state
		driver.findElement(By.className("innerspcr")).click();
		WebElement from = driver.findElement(By.id("a_FromSector_show"));
		from.click();
		from.sendKeys("Bangalore");
		driver.findElement(By.xpath("//span[text()='Bengaluru(BLR)']")).click();
		
		//selecting to state
		WebElement to = driver.findElement(By.id("a_Editbox13_show"));
		to.click();
		to.sendKeys("Bangkok");
		Thread.sleep(1000);
		driver.findElement(By.xpath("//span[text()='Bangkok(BKK)']")).click();
		
		//selecting departure date
		driver.findElement(By.id("frth_0_20/09/2026")).click();
		
		//clicking traveler and class
		driver.findElement(By.id("ptravlrNo")).click();
		driver.findElement(By.xpath("//button[text()='+']")).click();
		driver.findElement(By.id("lbEconomy")).click();
		driver.findElement(By.id("traveLer")).click();
		
		//click search
		driver.findElement(By.cssSelector("[value='Search']")).click();
		
		Thread.sleep(3000);
		//verify
		String url = driver.getCurrentUrl();

		if (url.contains("flight-search")) {
		    System.out.println("Flight Results page is displayed");
		} else {
		    System.out.println("Flight Results page is NOT displayed");
		}
}
}



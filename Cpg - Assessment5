package Assignment;
import java.io.File;
import java.io.IOException;
import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.io.FileHandler;

public class Assignment5 {

	public static void main(String[] args) throws InterruptedException, IOException {

		WebDriver driver = new ChromeDriver();

		driver.manage().window().maximize();

		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));

		// Navigate to DemoWebShop
		driver.get("https://demowebshop.tricentis.com/");

		
		driver.findElement(By.xpath("//a[@title='Show details for 14.1-inch Laptop']")).click();

		// Add to cart
		WebElement cart = driver.findElement(By.id("add-to-cart-button-31"));

		System.out.println("Add to Cart Size : " + cart.getSize());

		cart.click();

		Thread.sleep(2000);

		// Go to Shopping Cart
		driver.findElement(By.xpath("//a[@class='ico-cart']")).click();

		Thread.sleep(2000);

		WebElement removeCheckbox = driver.findElement(
				By.name("removefromcart"));

		if (removeCheckbox.isSelected()) {

			System.out.println("Remove checkbox is selected");

		} else {

			System.out.println("Remove checkbox is not selected");
		}

		// Capture complete information using getRect()
		System.out.println("X : "+ removeCheckbox.getRect().getX());

		System.out.println("Y : "+ removeCheckbox.getRect().getY());

		System.out.println("Width : "+ removeCheckbox.getRect().getWidth());

		System.out.println("Height : "+ removeCheckbox.getRect().getHeight());

		System.out.println("Complete Rect : "+ removeCheckbox.getRect());

		if (driver.findElements(By.className("message")).size() > 0) {

			System.out.println("Alert message is displayed BEFORE clicking Apply coupon");

		} else {

			System.out.println("Alert message is NOT displayed BEFORE clicking Apply coupon");
		}

		WebElement couponBox = driver.findElement(By.name("discountcouponcode"));

		couponBox.sendKeys("TEST123");

		// Apply coupon
		WebElement applyCoupon = driver.findElement(By.xpath("//input[@value='Apply coupon']"));

		applyCoupon.click();

		Thread.sleep(2000);

		if (driver.findElements(By.className("message")).size() > 0) {

			WebElement message = driver.findElement(By.className("message"));

			if (message.isDisplayed()) {

				System.out.println(
						"Alert message is displayed AFTER clicking Apply coupon");

				System.out.println("Message : " + message.getText());
			}

		} else {

			System.out.println(
					"Alert message is NOT displayed AFTER clicking Apply coupon");
		}

		
//		driver.get("https://demowebshop.tricentis.com/");

		Thread.sleep(2000);

		WebElement laptopImage = driver.findElement(By.xpath("//a[contains(text(),'14.1-inch Laptop')]/ancestor::tr//img"));
		File src = laptopImage.getScreenshotAs(OutputType.FILE);
		File dest = new File("./Ss/Laptop.png");
		FileHandler.copy(src, dest);

		System.out.println("Laptop screenshot captured successfully.");

		
		driver.quit();
	}
}
